---
/**
 * A figure with an optional caption.
 *
 * Wraps either an optimised image or arbitrary inline content (an SVG diagram,
 * a table) so both get the same spacing, caption treatment, and horizontal
 * scroll behaviour on narrow screens.
 *
 * For raster images pass `src` as an import from `src/assets/`, which routes it
 * through Astro's image pipeline: resized, converted to modern formats, and
 * given intrinsic dimensions so it cannot cause layout shift.
 *
 *   import diagram from '../assets/split.png';
 *   <Figure src={diagram} alt="..." caption="..." />
 *
 * For an inline diagram, pass children instead:
 *
 *   <Figure caption="..."><svg>...</svg></Figure>
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Imported image. Omit when passing inline content as children. */
  src?: ImageMetadata;
  /** Required whenever `src` is set. Describe the content, not the fact it is an image. */
  alt?: string;
  caption?: string;
  /** Let the figure exceed the text column, up to the viewport. */
  wide?: boolean;
}

const { src, alt = '', caption, wide = false } = Astro.props;

if (src && alt === '') {
  throw new Error('Figure: `alt` is required when `src` is provided.');
}
---

<figure class:list={['figure', wide && 'is-wide']}>
  <div class="figure-body">
    {src ? <Image src={src} alt={alt} loading="lazy" decoding="async" /> : <slot />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
  }

  /* Wide figures break out of the text column but never past the viewport. */
  .figure.is-wide {
    width: calc(100% + 6rem);
    max-width: 100vw;
    margin-left: -3rem;
    margin-right: -3rem;
  }

  /* Diagrams and tables scroll inside the figure rather than the page. */
  .figure-body {
    overflow-x: auto;
  }

  .figure-body :global(img),
  .figure-body :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted, #777);
    text-align: center;
  }

  @media (max-width: 800px) {
    .figure.is-wide {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
