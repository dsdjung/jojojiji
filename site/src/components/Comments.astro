---
/**
 * Reader comments, backed by the D1 + Pages Functions API in `functions/api/comments.js`.
 *
 * The page stays fully static: comments are fetched client side after load, so
 * the HTML is still cached at the edge.
 */

interface Props {
  /** Post identifier. Must match the slug used in the URL. */
  post: string;
  /** Heading shown above the thread. */
  heading?: string;
}

const { post, heading = 'Comments' } = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<section class="comments" data-post={post} data-turnstile-key={turnstileSiteKey}>
  <h3>{heading}</h3>

  <div class="comments-list" data-comments-list>
    <p class="comments-status" data-comments-status>Loading comments…</p>
  </div>

  <form class="comment-form" data-comment-form novalidate>
    <p class="comment-form-intro">
      Comments are reviewed before they appear. Your email is never published and is only
      used if a reply is needed.
    </p>

    <label class="comment-field">
      <span>Name</span>
      <input type="text" name="name" maxlength="80" required autocomplete="name" />
    </label>

    <label class="comment-field">
      <span>Email <em>(optional, not published)</em></span>
      <input type="email" name="email" maxlength="254" autocomplete="email" />
    </label>

    <label class="comment-field">
      <span>Comment</span>
      <textarea name="body" rows="5" maxlength="5000" required></textarea>
    </label>

    {/* Honeypot. Hidden from people, tempting to bots. */}
    <div class="comment-hp" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    {turnstileSiteKey && <div class="cf-turnstile" data-turnstile-mount></div>}

    <button type="submit" data-comment-submit>Post comment</button>

    <p class="comment-message" data-comment-message role="status" aria-live="polite"></p>
  </form>
</section>

{turnstileSiteKey && (
  <script
    is:inline
    async
    defer
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  ></script>
)}

<script>
  interface CommentRecord {
    id: string;
    name: string;
    body: string;
    createdAt: string;
  }

  declare global {
    interface Window {
      turnstile?: {
        render: (el: Element, opts: Record<string, unknown>) => string;
        reset: (id?: string) => void;
        getResponse: (id?: string) => string | undefined;
      };
    }
  }

  function initComments(root: HTMLElement) {
    const post = root.dataset.post ?? '';
    const turnstileKey = root.dataset.turnstileKey ?? '';

    const list = root.querySelector<HTMLElement>('[data-comments-list]');
    const status = root.querySelector<HTMLElement>('[data-comments-status]');
    const form = root.querySelector<HTMLFormElement>('[data-comment-form]');
    const message = root.querySelector<HTMLElement>('[data-comment-message]');
    const submit = root.querySelector<HTMLButtonElement>('[data-comment-submit]');
    const turnstileMount = root.querySelector<HTMLElement>('[data-turnstile-mount]');

    if (!list || !status || !form || !message || !submit) return;

    let turnstileWidgetId: string | undefined;

    const formatDate = (iso: string) => {
      const d = new Date(iso);
      return Number.isNaN(d.getTime())
        ? ''
        : d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    };

    /** Builds nodes with textContent, so comment text can never inject markup. */
    const renderComments = (comments: CommentRecord[]) => {
      list.replaceChildren();

      if (comments.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'comments-status';
        empty.textContent = 'No comments yet. Yours would be the first.';
        list.append(empty);
        return;
      }

      for (const c of comments) {
        const item = document.createElement('article');
        item.className = 'comment';

        const meta = document.createElement('div');
        meta.className = 'comment-meta';

        const author = document.createElement('span');
        author.className = 'comment-author';
        author.textContent = c.name;
        meta.append(author);

        const when = formatDate(c.createdAt);
        if (when) {
          const time = document.createElement('time');
          time.className = 'comment-date';
          time.dateTime = c.createdAt;
          time.textContent = when;
          meta.append(document.createTextNode(' · '), time);
        }

        const body = document.createElement('div');
        body.className = 'comment-body';
        for (const para of c.body.split(/\n{2,}/)) {
          const p = document.createElement('p');
          p.textContent = para.trim();
          if (p.textContent !== '') body.append(p);
        }

        item.append(meta, body);
        list.append(item);
      }
    };

    const load = async () => {
      try {
        const res = await fetch(`/api/comments?post=${encodeURIComponent(post)}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as { comments?: CommentRecord[] };
        renderComments(data.comments ?? []);
      } catch {
        status.textContent = 'Comments could not be loaded right now.';
      }
    };

    const mountTurnstile = () => {
      if (!turnstileKey || !turnstileMount || !window.turnstile) return;
      turnstileWidgetId = window.turnstile.render(turnstileMount, {
        sitekey: turnstileKey,
        theme: 'light',
      });
    };

    if (turnstileKey && turnstileMount) {
      // The Turnstile script may land before or after this module runs.
      if (window.turnstile) {
        mountTurnstile();
      } else {
        const poll = window.setInterval(() => {
          if (window.turnstile) {
            window.clearInterval(poll);
            mountTurnstile();
          }
        }, 200);
        window.setTimeout(() => window.clearInterval(poll), 10000);
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.textContent = '';
      message.classList.remove('is-error', 'is-success');

      const data = new FormData(form);
      const payload = {
        post,
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        body: String(data.get('body') ?? ''),
        website: String(data.get('website') ?? ''),
        turnstileToken: turnstileKey ? (window.turnstile?.getResponse(turnstileWidgetId) ?? '') : '',
      };

      if (payload.name.trim() === '' || payload.body.trim() === '') {
        message.textContent = 'Please add your name and a comment.';
        message.classList.add('is-error');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Posting…';

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await res.json()) as { message?: string; error?: string };

        if (res.ok) {
          form.reset();
          message.textContent = result.message ?? 'Thanks. Your comment is awaiting review.';
          message.classList.add('is-success');
        } else {
          message.textContent = result.error ?? 'Something went wrong. Please try again.';
          message.classList.add('is-error');
        }
      } catch {
        message.textContent = 'Something went wrong. Please try again.';
        message.classList.add('is-error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Post comment';
        if (turnstileKey) window.turnstile?.reset(turnstileWidgetId);
      }
    });

    void load();
  }

  document.querySelectorAll<HTMLElement>('.comments').forEach(initComments);
</script>

<style>
  .comments {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--comments-rule, #eee);
  }

  .comments h3 {
    font-size: 1rem;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .comments-status {
    font-size: 0.9rem;
    color: var(--comments-muted, #999);
  }

  .comment {
    padding: 1rem 0;
    border-bottom: 1px solid var(--comments-rule, #f0f0f0);
  }

  .comment-meta {
    font-size: 0.8rem;
    color: var(--comments-muted, #888);
    margin-bottom: 0.35rem;
  }

  .comment-author {
    font-weight: 700;
    color: var(--comments-strong, #333);
  }

  .comment-body p {
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }

  .comment-body p:last-child {
    margin-bottom: 0;
  }

  .comment-form {
    margin-top: 2rem;
  }

  .comment-form-intro {
    font-size: 0.85rem;
    color: var(--comments-muted, #888);
    margin-bottom: 1rem;
  }

  .comment-field {
    display: block;
    margin-bottom: 1rem;
  }

  .comment-field > span {
    display: block;
    font-size: 0.8rem;
    color: var(--comments-muted, #666);
    margin-bottom: 0.3rem;
    letter-spacing: 0.02em;
  }

  .comment-field em {
    font-style: italic;
    color: var(--comments-muted, #999);
  }

  .comment-field input,
  .comment-field textarea {
    width: 100%;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.6;
    color: inherit;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--comments-border, #ddd);
    border-radius: var(--comments-radius, 2px);
    background: var(--comments-input-bg, #fff);
  }

  .comment-field input:focus,
  .comment-field textarea:focus {
    outline: 2px solid var(--comments-focus, #1a1a1a);
    outline-offset: 1px;
  }

  .comment-field textarea {
    resize: vertical;
  }

  /* Honeypot: removed from the accessibility tree and off screen, never display:none
     (some bots skip hidden fields, and screen readers should not announce it). */
  .comment-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .comment-form button {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 0.55rem 1.4rem;
    border: 1px solid var(--comments-button-border, #1a1a1a);
    border-radius: var(--comments-radius, 2px);
    background: var(--comments-button-bg, #1a1a1a);
    color: var(--comments-button-fg, #fff);
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .comment-form button:hover:not(:disabled) {
    opacity: 0.85;
  }

  .comment-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .comment-message {
    margin-top: 0.75rem;
    margin-bottom: 0;
    font-size: 0.85rem;
    min-height: 1.2em;
  }

  .comment-message.is-error {
    color: var(--comments-error, #b3261e);
  }

  .comment-message.is-success {
    color: var(--comments-success, #1e6b3a);
  }

  .cf-turnstile {
    margin-bottom: 1rem;
  }
</style>
