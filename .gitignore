# Source video is NOT tracked.
#
# 2026-02-covered-bridges.mp4 is 470MB and 2026-02-travel-show.mp4 is 214MB. Both
# are over GitHub's 100MB per-file hard limit, and rendered footage does not belong
# in a site repo. Keep masters in cloud storage or an external drive; published
# videos live on YouTube and are embedded by ID via the `youtubeId` frontmatter.
video/**/*.mp4
video/**/*.mov
video/**/*.m4v
video/**/*.avi
video/**/*.prproj
video/**/*.wav
video/**/*.aiff

# Large binary design sources are fine to track (they are small here), but exports
# and caches are not.
assets/**/*.tmp
**/Adobe Premiere Pro Auto-Save/
**/Adobe Premiere Pro Video Previews/

# Node / Astro
node_modules/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare / wrangler
.wrangler/
.dev.vars

# Environment
.env
.env.production

# OS / IDE
.DS_Store
.vscode/
.idea/
